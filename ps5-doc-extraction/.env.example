# LLM backend: local Ollama by default
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://127.0.0.1:11434
# LLM_PROVIDER=openai     LLM_MODEL=gpt-4o-mini   LLM_BASE_URL=https://api.openai.com/v1   LLM_API_KEY=sk-...
# LLM_PROVIDER=anthropic  LLM_MODEL=claude-opus-5-5   (pip install anthropic; uses ANTHROPIC_API_KEY)

MAX_UPLOAD_MB=10
MAX_PAGES=20
OCR_ENABLED=true
OCR_MIN_CHARS_PER_PAGE=30
