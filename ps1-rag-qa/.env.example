# ---- LLM backend --------------------------------------------------------
# Local (default): Ollama
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://127.0.0.1:11434

# Hosted, OpenAI-compatible API (OpenAI, Groq, Together, vLLM, LM Studio, ...)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...

# Hosted, Anthropic Claude (pip install anthropic; uses ANTHROPIC_API_KEY)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5-5

# ---- Embeddings ---------------------------------------------------------
EMBED_PROVIDER=ollama
EMBED_MODEL=embeddinggemma
EMBED_BASE_URL=http://127.0.0.1:11434

# ---- Retrieval knobs ----------------------------------------------------
RETRIEVAL_MODE=hybrid
TOP_K=5
MIN_DENSE_SCORE=0.30
BM25_WEIGHT=0.3
CHUNK_SIZE=900
CHUNK_OVERLAP=150
